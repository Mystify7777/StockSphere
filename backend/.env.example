APP_NAME=StockSphere
APP_ENV=development
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=stocksphere
DB_USERNAME=root
DB_PASSWORD=yourpassword

JWT_SECRET=change_this_to_long_random_secret_32_bytes_minimum
JWT_EXPIRATION_MS=900000

CORS_ALLOWED_ORIGINS=http://localhost:5173

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
